# Saloonify Environment Configuration Template

# Server Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL Database Configuration
# Option A: Connection URL string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/saloonify

# Option B: Individual PostgreSQL parameters
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_password
PGDATABASE=saloonify
PGSSL=false

# Authentication Token Secret (JWT)
JWT_SECRET=saloonify-secure-jwt-secret-key-change-in-production

# WhatsApp Business API (Optional)
# If left blank, Saloonify uses the instant WhatsApp click-to-chat receipt delivery with pre-filled items & totals.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
